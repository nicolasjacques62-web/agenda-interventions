# Modèle de configuration pour la PRODUCTION (hébergeur en ligne)
# Sur votre hébergeur, créez ces variables d'environnement avec vos vraies valeurs

# Clé secrète — générez une clé aléatoire longue (ex: 50 caractères)
SECRET_KEY=remplacez-par-une-cle-aleatoire-longue-et-unique

# URL PostgreSQL fournie par votre hébergeur (Render, Railway, PythonAnywhere...)
DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/nom_base

# URL publique de votre application (pour les liens portail client)
BASE_URL=https://votre-app.onrender.com

# Intégration Outlook (Microsoft Graph) — obtenus en déclarant l'application
# sur https://portal.azure.com > App registrations > New registration
# (type de compte : "Comptes personnels Microsoft uniquement" ou multi-tenant).
# Redirect URI à déclarer : https://votre-app.onrender.com/outlook/callback
APP_OUTLOOK_CLIENT_ID=votre-application-client-id
APP_OUTLOOK_CLIENT_SECRET=votre-client-secret
